---
import Panel from '@components/Panel.astro';
import Links from '@components/Links.astro';
---

<Panel weight={100}>
	<div class="hero h-screen scroll-mt-16" id="hero">
		<div class="hero-content">
			<div class="max-w-md text-center">
				<h1 class="font-mono font-extrabold text-5xl text-transparent bg-clip-text bg-gradient-to-r from-info via-primary to-error">
					Finn Cooper
				</h1>
				<p class="py-6">
					Computer Science MEng Graduate | Software Engineer
				</p>
				<div class="grid grid-flow-col gap-4 justify-center items-center">
					<Links/>
					<a class="btn btn-primary" href="/cv.pdf" download>Download CV</a>
				</div>
			</div>
		</div>
		<div class="absolute bottom-10">
			<a class="btn btn-ghost" href="/#projects" aria-label="scroll down">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
			</a>
		</div>
	</div>
</Panel>
