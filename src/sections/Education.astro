---
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
---

<Section id="education" title="Education" weight={100}>
	<Card
		title="University of Bristol"
		date="2022-2026"
		content={<p>Master of Engineering in Computer Science (First Class Honours)</p>}
		hover
	/>
	<div class="flex flex-col md:flex-row gap-4">
		<Card
			title="Brighton Hove and Sussex Sixth Form College"
			date="2020-2022"
			content={<p>A-Levels in Maths, Further Maths, Computer Science, and Physics (A* A* A* A)</p>}
			hover
		/>
		<Card
			title="Downlands Community School"
			date="2015-2020"
			content={<p>11 GCSEs including Computer Science, Music, German and Geography</p>}
			hover
		/>
	</div>
</Section>
