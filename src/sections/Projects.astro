---
import projects from '@data/projects.json';
import Panel from '@components/Panel.astro';
import Card from '@components/Card.astro';
---

<Panel weight={300}>
	<div class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-4 p-12 scroll-mt-16" id="projects">
		{projects.map(project =>
			<Card
				title={project.title}
				image={project.coverImage}
				// content={<ul>{project.content?.map((item) => <li>{item}</li>)}</ul>}
				actions={<a class="btn btn-sm btn-soft btn-primary" href={`/projects/${project.slug}`}>View Project</a>}
			/>
		)}
	</div>
</Panel>
