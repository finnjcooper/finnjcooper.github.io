---
import projects from '@data/projects.json';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
---

<Section id="projects" weight={300} centred>
	<div class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-4 p-12">
		{projects.map(project =>
			<Card
				title={project.title}
				image={project.coverImage}
				// content={<ul>{project.content?.map((item) => <li>{item}</li>)}</ul>}
				actions={<a class="btn btn-sm btn-soft btn-primary" href={`/projects/${project.slug}`}>View Project</a>}
			/>
		)}
	</div>
</Section>
