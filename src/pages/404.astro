---
import Layout from '@layouts/Layout.astro';
import Section from '@components/Section.astro';
---

<Layout title="404 Not Found" description="Page not found.">
	<Section weight={300} id="404" centred>
		<h1 class="text-6xl font-bold text-error">404</h1>
		<p class="text-xl">Sorry, the page you are looking for does not exist.</p>
		<a href="/" class="text-lg link link-primary link-hover">Go back home.</a>
	</Section>
</Layout>
