---
import Layout from '@layouts/Layout.astro';
import Panel from '@components/Panel.astro';
---

<Layout title="404 Not Found" description="Page not found.">
	<Panel weight={300}>
		<div class="flex flex-col flex-1 items-center justify-center gap-4">
			<h1 class="text-5xl font-bold text-error">404</h1>
			<p class="text-lg">Sorry, the page you are looking for does not exist.</p>
			<a href="/" class="link link-primary link-hover">Go back home.</a>
		</div>
	</Panel>
</Layout>
