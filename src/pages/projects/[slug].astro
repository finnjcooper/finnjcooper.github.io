---
export function getStaticPaths() {
	return [
		{ params: { slug: "game-of-life" }},
		{ params: { slug: "livestock-management" }},
		// { params: { slug: "portfolio-website" }},
		{ params: { slug: "rasteriser-raytracer" }},
		{ params: { slug: "shifting-sands" }},
		// { params: { slug: "valorant-tracker" }},
		{ params: { slug: "asymphony" }},
	];
}

import projects from "@data/projects.json";
import Layout from '@layouts/Layout.astro';
import Header from '@sections/Header.astro';
import Footer from '@sections/Footer.astro';
import Section from '@components/Section.astro';

const { slug } = Astro.params;
const project = projects.find(p => p.slug === slug)!;
---

<Layout title={project.title} description={project.description}>
	<Header/>
	<main class="flex flex-col flex-1">
		<Section weight={100} id="content" title={project.title}>
			<div class="grid grid-cols-2 gap-16">
				<ul>{project.content && project.content.map(item => <li>{item}</li>)}</ul>
				<div class="carousel carousel-center rounded-box">
					{project.media && project.media.map((media, index) => {
						switch (media.type) {
							case "image":
								return (
									<div class="carousel-item relative w-full" id={`slide-${index}`}>
										<img src={media.src} alt={media.alt} class="object-contain"/>
										<div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
											<a href={`#slide-${index - 1 < 0 ? project.media.length - 1 : index - 1}`} class="btn btn-circle">❮</a>
											<a href={`#slide-${index + 1 >= project.media.length ? 0 : index + 1}`} class="btn btn-circle">❯</a>
										</div>
									</div>
								);
							case "video":
								return (
									<div class="carousel-item relative w-full" id={`slide-${index}`}>
										<video src={media.src} controls preload="metadata" class="object-contain"/>
										<div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
											<a href={`#slide-${index - 1 < 0 ? project.media.length - 1 : index - 1}`} class="btn btn-circle">❮</a>
											<a href={`#slide-${index + 1 >= project.media.length ? 0 : index + 1}`} class="btn btn-circle">❯</a>
										</div>
									</div>
								);
							case "preview":
								return (
									<div class="carousel-item relative w-full" id={`slide-${index}`}>
										<img src={media.src} alt={media.alt} class="object-contain"/>
										<div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
											<a href={`#slide-${index - 1 < 0 ? project.media.length - 1 : index - 1}`} class="btn btn-circle">❮</a>
											<a href={`#slide-${index + 1 >= project.media.length ? 0 : index + 1}`} class="btn btn-circle">❯</a>
										</div>
										{/* <div>full</div> */}
									</div>
								);
							default:
								return null;
						}
					})}
				</div>
			</div>
		</Section>
	</main>
	<Footer/>
</Layout>
