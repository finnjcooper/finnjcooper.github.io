---
interface Props {
	weight?: 100 | 200 | 300;
	opacity?: 25 | 50 | 75 | 100;
}

const { weight = 100, opacity = 100 } = Astro.props;

const bgClasses = {
	"100-25": "bg-base-100/25",
	"100-50": "bg-base-100/50",
	"100-75": "bg-base-100/75",
	"100-100": "bg-base-100",

	"200-25": "bg-base-200/25",
	"200-50": "bg-base-200/50",
	"200-75": "bg-base-200/75",
	"200-100": "bg-base-200",

	"300-25": "bg-base-300/25",
	"300-50": "bg-base-300/50",
	"300-75": "bg-base-300/75",
	"300-100": "bg-base-300",
} as const;

const bg = bgClasses[`${weight}-${opacity}`];
---

<section class={`${bg} w-screen text-base-content`}>
	<div class="max-w-5xl mx-auto">
		<slot/>
	</div>
</section>
