---
const { title, image, content, actions } = Astro.props;
---

<div class="card card-border bg-base-200 text-base-content shadow-md">
	{image && (
		<figure>
			<img src={image} alt={title}/>
		</figure>
	)}
	<div class="card-body">
		<h2 class="card-title text-primary">{title}</h2>
		<div>{content}</div>
		{actions && (
			<div class="card-actions justify-end mt-auto">
				{actions}
			</div>
		)}
	</div>
</div>
