---
interface Props {
	title?: string;
	date?: string;
	image?: string;
	content?: any;
	actions?: any;
	hover?: boolean;
}

const { title, date, image, content, actions, hover } = Astro.props as Props;
---

<div class=`card card-border border-neutral flex-1 bg-base-200 text-base-content shadow-lg ${hover && "transition-transform hover:scale-105"}`>
	{image && (
		<figure class="h-48 w-full overflow-hidden">
			<img src={image} alt={title}/>
		</figure>
	)}
	<div class="card-body">
		<div class="flex gap-4 items-center justify-between">
			{title && <h2 class="card-title text-primary">{title}</h2>}
			{date && <p class="text-sm text-base-content/70 text-right">{date}</p>}
		</div>
		{content && <div>{content}</div>}
		{actions && (
			<div class="card-actions justify-end pt-4 mt-auto">
				{actions}
			</div>
		)}
	</div>
</div>
